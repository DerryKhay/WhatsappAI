{
  "name": "whatsapp-ai-autoresponder",
  "version": "1.0.0",
  "description": "Smart WhatsApp AI Auto-Responder bot powered by Gemini and OpenAI",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "start:daemon": "pm2 start src/index.js --name whatsapp-bot",
    "stop:daemon": "pm2 stop whatsapp-bot",
    "restart:daemon": "pm2 restart whatsapp-bot",
    "logs:daemon": "pm2 logs whatsapp-bot",
    "status:daemon": "pm2 status",
    "clean-session": "rm -rf auth_info"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "autoresponder",
    "bot",
    "ai",
    "gemini",
    "openai"
  ],
  "author": "derrykhay",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "openai": "^6.49.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  }
}
