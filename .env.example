# ==========================================
# WhatsApp AI Auto-Responder Configuration
# ==========================================

# AI Provider to use: "gemini" or "openai"
AI_PROVIDER=gemini

# ------------------------------------------
# Google Gemini Configuration (Recommended)
# Get a free key at: https://aistudio.google.com/app/apikey
# ------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------
# OpenAI Configuration (Optional alternative)
# Get your key at: https://platform.openai.com/api-keys
# ------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------
# Bot Personality & Owner Details
# ------------------------------------------
OWNER_NAME=Derry
BOT_NAME="Derry's Assistant"

# The instructions that shape how the AI behaves and replies
SYSTEM_PROMPT="You are a personal WhatsApp AI assistant replying on behalf of Derry. Derry is currently away or busy. Respond in a friendly, polite, natural, and helpful manner. Keep messages concise and formatted nicely for WhatsApp (use short paragraphs and occasional emojis). If someone leaves an urgent message, assure them that Derry has been notified."

# ------------------------------------------
# Behavior & Privacy Controls
# ------------------------------------------
# Whether to auto-respond in group chats (default: false to avoid spamming groups)
AUTO_REPLY_GROUPS=false

# Wait time in milliseconds to collect rapid consecutive messages from the same sender before replying
DEBOUNCE_DELAY_MS=2500

# Minimum seconds between auto-replies to the same contact (0 = reply to all new incoming queries)
COOLDOWN_SECONDS=0

# Show 'typing...' indicator in WhatsApp while generating AI answer
ENABLE_TYPING_INDICATOR=true

# Numbers filter (comma-separated phone numbers with country code, e.g. 1234567890,9876543210)
# Leave ALLOWED_NUMBERS empty to reply to all private chats
ALLOWED_NUMBERS=
# Numbers that should NEVER receive an auto-reply
BLOCKED_NUMBERS=

# Maximum conversation history turns to remember per contact
MAX_HISTORY_TURNS=10
